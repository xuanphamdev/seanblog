---
import { LOCALES, type Locale } from "../lib/site-config";
import { withBase, withoutBase } from "../lib/paths";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const path = withoutBase(Astro.url.pathname);

function swapPath(p: string, to: Locale): string {
  // Replace /vi/... or /en/... with /to/...
  return withBase(p.replace(/^\/(vi|en)(\/|$)/, `/${to}$2`));
}
---

<nav class="lang-switch" aria-label="Language">
  {
    LOCALES.map((loc) => (
      <a
        href={swapPath(path, loc)}
        class:list={["lang-link", { active: loc === lang }]}
        lang={loc}
        aria-current={loc === lang ? "true" : undefined}
      >
        {loc.toUpperCase()}
      </a>
    ))
  }
</nav>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-subtle);
  }
  .lang-link {
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast) var(--ease);
  }
  .lang-link:hover { color: var(--accent); }
  .lang-link.active {
    color: var(--fg);
    background: var(--accent-soft);
  }
</style>
