---
/**
 * Reading progress bar — sits at the top of viewport, fills as the user scrolls.
 * Uses a CSS custom property updated by a tiny scroll listener.
 * Marked transition:persist so the same DOM survives view transitions
 * (script attaches once).
 */
---

<div class="reading-progress" aria-hidden="true"></div>

<script is:inline>
  (() => {
    const bar = document.querySelector(".reading-progress");
    if (!bar) return;

    function update() {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      const pct = max <= 0 ? 0 : Math.min(1, Math.max(0, h.scrollTop / max));
      bar.style.setProperty("--progress", String(pct));
    }

    // Initial paint
    update();

    // Use passive scroll for perf
    document.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });

    // Re-measure after view transitions (page swap changes scrollHeight)
    document.addEventListener("astro:page-load", update);
  })();
</script>
