---
import type { Locale } from "../lib/site-config";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const labels = {
  vi: "Lên đầu trang",
  en: "Back to top",
};
---

<button
  type="button"
  class="back-to-top"
  data-back-to-top
  aria-label={labels[lang]}
  title={labels[lang]}
  aria-hidden="true"
  tabindex="-1"
>
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="m18 15-6-6-6 6"></path>
  </svg>
</button>

<style>
  .back-to-top {
    position: fixed;
    right: clamp(var(--space-4), 3vw, var(--space-8));
    bottom: clamp(var(--space-4), 3vw, var(--space-8));
    z-index: var(--z-toast);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: color-mix(in oklch, var(--bg-elevated) 92%, transparent);
    color: var(--fg-muted);
    box-shadow: 0 12px 34px oklch(0% 0 0 / 0.22);
    backdrop-filter: blur(10px);
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition:
      opacity var(--duration-normal) var(--ease),
      transform var(--duration-normal) var(--ease),
      color var(--duration-fast) var(--ease),
      border-color var(--duration-fast) var(--ease),
      background var(--duration-fast) var(--ease);
  }

  .back-to-top.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .back-to-top:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  @media (max-width: 720px) {
    .back-to-top {
      width: 38px;
      height: 38px;
      bottom: var(--space-4);
      right: var(--space-4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const getButtons = () => document.querySelectorAll("[data-back-to-top]");

    const updateVisibility = () => {
      const isVisible = window.scrollY > 420;
      getButtons().forEach((button) => {
        button.classList.toggle("is-visible", isVisible);
        button.setAttribute("aria-hidden", String(!isVisible));
        button.tabIndex = isVisible ? 0 : -1;
      });
    };

    if (!window.__seandevBackToTopReady) {
      document.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;
        const button = event.target.closest("[data-back-to-top]");
        if (!button) return;

        const prefersReducedMotion = matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        window.scrollTo({
          top: 0,
          behavior: prefersReducedMotion ? "auto" : "smooth",
        });
      });

      document.addEventListener("scroll", updateVisibility, { passive: true });
      window.addEventListener("resize", updateVisibility, { passive: true });
      document.addEventListener("astro:page-load", updateVisibility);
      window.__seandevBackToTopReady = true;
    }

    updateVisibility();
  })();
</script>
