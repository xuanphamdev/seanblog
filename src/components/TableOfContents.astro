---
import type { MarkdownHeading } from "astro";
import type { Locale } from "../lib/site-config";

interface Props {
  headings: MarkdownHeading[];
  lang: Locale;
}
const { headings, lang } = Astro.props;

// Only show h2 + h3
const filtered = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

const heading = lang === "vi" ? "Trong bài này" : "On this page";
---

{
  filtered.length >= 2 && (
    <aside class="toc" aria-label={heading}>
      <details open class="toc-details">
        <summary class="toc-summary">{heading}</summary>
        <ol class="toc-list">
          {filtered.map((h) => (
            <li class:list={["toc-item", `depth-${h.depth}`]}>
              <a href={`#${h.slug}`} class="toc-link" data-toc-slug={h.slug}>
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </details>
    </aside>
  )
}

<style>
  .toc {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }
  .toc-details > summary {
    cursor: pointer;
    list-style: none;
    color: var(--fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-3);
    user-select: none;
  }
  .toc-details > summary::-webkit-details-marker { display: none; }
  .toc-details > summary::before {
    content: "▾ ";
    color: var(--accent);
    opacity: 0.7;
    transition: transform var(--duration-fast) var(--ease);
  }
  .toc-details:not([open]) > summary::before {
    content: "▸ ";
  }
  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--border-subtle);
  }
  .toc-item {
    padding-left: var(--space-3);
  }
  .toc-item.depth-3 {
    padding-left: var(--space-6);
  }
  .toc-link {
    display: block;
    padding-block: var(--space-1);
    color: var(--fg-muted);
    line-height: 1.4;
    transition: color var(--duration-fast) var(--ease);
    border-left: 2px solid transparent;
    margin-left: calc(-1 * var(--space-3) - 1px);
    padding-left: calc(var(--space-3) - 1px);
  }
  .toc-link:hover { color: var(--accent); }
  .toc-link.active {
    color: var(--fg);
    border-left-color: var(--accent);
  }

  @media (min-width: 1024px) {
    .toc {
      position: sticky;
      top: var(--space-8);
      max-height: calc(100vh - var(--space-16));
      overflow-y: auto;
    }
    .toc-details > summary {
      cursor: default;
      pointer-events: none;
    }
    .toc-details > summary::before {
      display: none;
    }
  }
</style>

<script is:inline>
  (() => {
    let observer = null;

    function init() {
      // Disconnect previous observer if any (View Transitions re-run init)
      if (observer) observer.disconnect();

      const links = document.querySelectorAll(".toc-link[data-toc-slug]");
      if (!links.length) return;

      const map = new Map();
      links.forEach((link) => {
        const slug = link.getAttribute("data-toc-slug");
        const heading = document.getElementById(slug);
        if (heading) map.set(heading, link);
      });

      observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const link = map.get(entry.target);
            if (!link) return;
            if (entry.isIntersecting) {
              links.forEach((l) => l.classList.remove("active"));
              link.classList.add("active");
            }
          });
        },
        { rootMargin: "0% 0% -70% 0%" },
      );
      map.forEach((_link, heading) => observer.observe(heading));
    }

    // Initial load
    init();

    // Re-init after view transitions
    document.addEventListener("astro:page-load", init);
  })();
</script>
